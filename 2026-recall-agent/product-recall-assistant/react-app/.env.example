PORT=3001
# Use an ADB TLS descriptor, or a TNS alias from the wallet's tnsnames.ora.
# Do not use the ORDS URL, for example https://.../ords/...
ORACLE_CONNECT_STRING=your-adb-host:1522/your-service-name
# Required for a wallet/TNS alias connection. Leave blank for a copied TLS descriptor.
ORACLE_CONFIG_DIR=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=
COOKIE_SECURE=false
